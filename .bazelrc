# The companion modules of @libtorch that are not (yet) in the Bazel Central
# Registry are served from the bazel_libtorch registry.
common --registry=https://asymingt.github.io/bazel_libtorch/
common --registry=https://bcr.bazel.build

# Flags the overlays rely on with the hermetic @llvm toolchain (see
# bazel_libtorch's .bazelrc for the full set its CI uses).
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --features=system_include_paths
common --@llvm//config:experimental_stub_libgcc_s=False

try-import %workspace%/user.bazelrc
